{
  "schemaVersion": 1,
  "name": "Hacker News Thread",
  "description": "Save a Hacker News story with its comment tree as nested blockquotes.",
  "urlPattern": "news.ycombinator.com/item?id=*",
  "baseTemplateId": "hackernews",
  "folder": "Social/Hacker News",
  "propertiesEnabled": true,
  "properties": [
    { "name": "title", "type": "string", "value": "{{title}}" },
    { "name": "source", "type": "string", "value": "{{url}}" },
    { "name": "link", "type": "string", "value": "{{storyUrl}}" },
    { "name": "author", "type": "string", "value": "{{author}}" },
    { "name": "points", "type": "number", "value": "{{points}}" },
    { "name": "comments", "type": "number", "value": "{{commentCount}}" },
    { "name": "published", "type": "date", "value": "{{published}}" },
    { "name": "tags", "type": "tags", "value": "hackernews" }
  ],
  "contentTemplate": "{if:storyUrl}[{storyUrl}]({storyUrl})\n\n{/if}{if:text}{text}\n\n{/if}{if:comments}## Comments\n\n{comments}{/if}"
}
