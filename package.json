{
  "name": "octarine-extension",
  "private": true,
  "version": "1.0.0",
  "description": "Browser extension to clip web pages to Octarine",
  "type": "module",
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:chromium",
    "build:chromium": "tsc -b && vite build --mode chromium",
    "build:firefox": "tsc -b && vite build --mode firefox",
    "build:safari": "tsc -b && vite build --mode safari",
    "build:all": "pnpm build:chromium && pnpm build:firefox && pnpm build:safari",
    "build:watch": "vite build --mode chromium --watch",
    "package": "bash scripts/package.sh",
    "safari:convert": "pnpm build:safari && xcrun safari-web-extension-converter dist/safari --app-name 'Octarine Web Clipper' --bundle-identifier 'com.octarine.web-clipper' --macos-only --no-open --force",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "lucide-react": "^0.562.0",
    "lz-string": "^1.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "turndown": "^7.2.2",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.33",
    "@eslint/js": "^9.39.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/jsdom": "^27.0.0",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@types/webextension-polyfill": "^0.12.4",
    "@tailwindcss/typography": "^0.5.19",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.23",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "nanoid@<3.3.18": "3.3.18",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss-selector-parser@>=6.1.0 <6.1.3": "6.1.3"
    }
  }
}
